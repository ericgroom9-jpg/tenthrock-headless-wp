0:{"buildId":"htnquw6910DOh0QVTIK8D","rsc":["$","$1","c",{"children":[["$","$L2",null,{"industryName":"Hospitality","heroImage":"/assets_export/stock_images/industry-hospitality.jpg","heroDescription":"Discreet, reliable waste management that protects your guest experience. We help hotels and resorts maintain impeccable standards while advancing sustainability goals.","aboutTitle":"Invisible Service, Visible Results","aboutImage":"/assets_export/stock_images/industry-hospitality.jpg","bulletPoints":[{"title":"Guest Experience Protection","description":"Discreet service scheduling and equipment placement that keeps waste operations invisible to guests. We protect the ambiance you've worked hard to create."},{"title":"Food Waste & Kitchen Support","description":"Specialized handling for kitchen waste, cooking oil recycling, and food scraps. We help manage the unique waste streams of hospitality food service."},{"title":"Multi-Property Coordination","description":"Centralized management for hotel groups and resort portfolios. Consistent service standards across all your properties with unified reporting."},{"title":"Sustainability Certifications","description":"Support for LEED, Green Key, and other hospitality sustainability programs. We provide the documentation and diversion rates you need for certification."}],"faqs":[{"question":"How do you ensure service doesn't disrupt guests?","answer":"We schedule pickups during low-traffic hours and position equipment in service areas away from guest sightlines. Our crews are trained in hospitality environment protocols and maintain a professional, unobtrusive presence."},{"question":"Can you handle conference and banquet waste?","answer":"Yes, we provide additional capacity for large events, conferences, and banquets. We work with your events team to pre-position resources and ensure rapid cleanup that supports quick room turnovers."},{"question":"Do you offer cooking oil recycling?","answer":"Absolutely. We provide dedicated cooking oil collection and recycling services for hotel kitchens and restaurants. This keeps grease out of your waste stream and supports sustainable practices."},{"question":"How do you support our sustainability initiatives?","answer":"We help hotels implement recycling programs, track diversion rates, and provide detailed reporting for sustainability certifications. Many of our hotel partners have achieved significant improvements in their environmental metrics."},{"question":"Can you service multiple properties under one agreement?","answer":"Yes, we specialize in multi-property management for hotel groups. You get consistent service standards, unified billing, and a single point of contact for all your properties."}]}],[["$","script","script-0",{"src":"/_next/static/chunks/8d692c28036d0a64.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/6df2bbe1833bd808.js","async":true}],["$","script","script-2",{"src":"/_next/static/chunks/b49b4fda3f11223a.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"loading":null,"isPartial":false}
