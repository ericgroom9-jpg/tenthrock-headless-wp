0:{"buildId":"htnquw6910DOh0QVTIK8D","rsc":["$","$1","c",{"children":[["$","$L2",null,{"industryName":"Retail","heroImage":"/assets_export/stock_images/indoor-hotel-view_1768502512665.jpg","heroDescription":"Keep your stores clean and operations running smoothly. Waste management solutions designed for the unique demands of retail environments.","aboutTitle":"Retail-Ready Waste Solutions","aboutImage":"/assets_export/stock_images/indoor-hotel-view_1768502512665.jpg","bulletPoints":[{"title":"Store Operations Support","description":"Reliable waste and recycling services that fit your store's schedule. We work around your operating hours to ensure minimal disruption to customers and staff."},{"title":"Cardboard & Packaging Recycling","description":"High-volume cardboard and packaging material recycling that turns your waste stream into a sustainability story. We help retailers reduce costs and environmental impact."},{"title":"Multi-Location Consistency","description":"Uniform service standards across all your retail locations. Whether you have 10 stores or 1,000, we deliver consistent quality and reporting."},{"title":"Seasonal Flexibility","description":"Scalable service that adjusts to holiday rushes, sales events, and seasonal inventory changes. More capacity when you need it, right-sized service when you don't."}],"faqs":[{"question":"Can you service our stores after hours?","answer":"Absolutely. We schedule most retail pickups during early morning or late evening hours to avoid customer interference. Our crews are trained to work quickly and quietly around retail environments."},{"question":"How do you handle holiday and seasonal volume increases?","answer":"We proactively increase service frequency and container capacity during peak retail seasons. We work with your operations team to anticipate needs and prevent overflow situations."},{"question":"Do you offer compactor services for high-volume locations?","answer":"Yes, we provide and service compactors for retail locations with significant cardboard and waste volumes. Compactors reduce pickup frequency and can significantly lower your waste management costs."},{"question":"Can you help with store remodels or closures?","answer":"We provide roll-off containers and cleanout services for store renovations, fixture changes, and store closures. We handle everything from construction debris to old inventory disposal."},{"question":"How do you handle nationwide retail chains?","answer":"We manage waste programs for national retailers with hundreds of locations. Our centralized management platform provides visibility across all locations with local service quality."}]}],[["$","script","script-0",{"src":"/_next/static/chunks/8d692c28036d0a64.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/6df2bbe1833bd808.js","async":true}],["$","script","script-2",{"src":"/_next/static/chunks/b49b4fda3f11223a.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"loading":null,"isPartial":false}
