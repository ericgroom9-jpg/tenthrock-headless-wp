0:{"buildId":"htnquw6910DOh0QVTIK8D","rsc":["$","$1","c",{"children":[["$","$L2",null,{"industryName":"Real Estate","heroImage":"/images/stock/industry-real-estate-balconies.jpg","heroDescription":"Professional waste management that protects property values and keeps tenants satisfied. Reliable service for property managers and real estate portfolios.","aboutTitle":"Supporting Property Excellence","aboutImage":"/images/stock/industry-real-estate-balconies.jpg","bulletPoints":[{"title":"Multi-Unit Property Services","description":"Comprehensive waste solutions for apartment complexes, condominiums, and residential communities. We keep your common areas clean and residents happy."},{"title":"Tenant Turnover Support","description":"Fast cleanout services for unit turnovers, abandoned property, and eviction cleanups. We help you get units back on the market quickly."},{"title":"Commercial Property Management","description":"Waste services for office buildings, shopping centers, and mixed-use developments. Coordinated service that meets the needs of diverse tenant mixes."},{"title":"Property Value Protection","description":"Clean, well-maintained waste areas enhance curb appeal and property values. We provide equipment and service that reflects well on your properties."}],"faqs":[{"question":"Can you handle multiple properties under one contract?","answer":"Yes, we specialize in portfolio management for property managers and real estate companies. One contract, one invoice, one point of contact for all your properties."},{"question":"How quickly can you do unit cleanouts?","answer":"For standard unit turnovers, we typically complete cleanouts within 24-48 hours. For emergency situations or evictions, we can often respond same-day with advance notice."},{"question":"Do you provide recycling for apartment communities?","answer":"Yes, we design and implement recycling programs that work for multi-family communities. This includes resident education, proper container placement, and contamination management."},{"question":"How do you handle large item disposal for residents?","answer":"We offer bulk pickup services for furniture, appliances, and other large items. This can be scheduled on a regular basis or as-needed to keep your property clean and prevent illegal dumping."},{"question":"Can you customize service for different properties?","answer":"Absolutely. Each property is different, and we tailor service frequency, container sizes, and placement to meet the specific needs of each community in your portfolio."}]}],[["$","script","script-0",{"src":"/_next/static/chunks/8d692c28036d0a64.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/6df2bbe1833bd808.js","async":true}],["$","script","script-2",{"src":"/_next/static/chunks/b49b4fda3f11223a.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"loading":null,"isPartial":false}
