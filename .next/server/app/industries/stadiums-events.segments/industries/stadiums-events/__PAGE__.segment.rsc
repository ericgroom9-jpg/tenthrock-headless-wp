0:{"buildId":"htnquw6910DOh0QVTIK8D","rsc":["$","$1","c",{"children":[["$","$L2",null,{"industryName":"Stadiums & Events","heroImage":"/assets_export/stock_images/industry-stadiums-events.jpg","heroDescription":"Expert waste management for stadiums, arenas, concert venues, and major events. We handle the logistics so you can focus on delivering unforgettable experiences.","aboutTitle":"Event-Ready Waste Solutions","aboutImage":"/assets_export/stock_images/industry-stadiums-events.jpg","bulletPoints":[{"title":"High-Volume Event Support","description":"Scalable waste solutions designed for crowds of any size. From intimate concerts to 100,000+ stadium events, we deploy the right resources at the right time."},{"title":"Rapid Turnaround Cleanup","description":"Post-event cleanup crews ready to restore your venue to pristine condition. We work through the night so you're ready for the next event or business day."},{"title":"Fan-Facing Recycling Programs","description":"Branded recycling stations and clear signage that encourage proper waste sorting. Help your fans be part of your sustainability story."},{"title":"Vendor & Concession Coordination","description":"We work directly with food vendors and concession operators to manage back-of-house waste streams, grease disposal, and cardboard recycling."}],"faqs":[{"question":"How quickly can you mobilize for an unplanned event?","answer":"We maintain standby capacity in major markets and can typically deploy additional resources within 24-48 hours for unexpected needs. For regular clients, we build surge capacity into your service plan."},{"question":"Do you handle specialty waste from events?","answer":"Yes, we manage all event waste streams including food waste, cooking oil, cardboard from vendors, and specialty items. We also coordinate hazardous waste disposal for pyrotechnics and other special effects materials."},{"question":"Can you provide waste diversion reporting for sustainability goals?","answer":"Absolutely. We provide detailed post-event reports showing total waste volumes, recycling rates, and diversion metrics. Many of our venue partners use these reports for LEED certification and corporate sustainability reporting."},{"question":"How do you handle waste during multi-day festivals?","answer":"For multi-day events, we establish on-site command centers and maintain continuous service. We perform rolling cleanups, manage overflow, and ensure facilities remain clean throughout the entire event duration."},{"question":"What's your approach to fan-facing waste stations?","answer":"We design and deploy clear, intuitive waste stations that make it easy for fans to sort correctly. This includes color-coded bins, clear signage, and strategic placement based on traffic flow analysis."}]}],[["$","script","script-0",{"src":"/_next/static/chunks/8d692c28036d0a64.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/6df2bbe1833bd808.js","async":true}],["$","script","script-2",{"src":"/_next/static/chunks/b49b4fda3f11223a.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"loading":null,"isPartial":false}
